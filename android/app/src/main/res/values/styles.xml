<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PaperFlight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paper_background</item>
        <item name="android:colorAccent">@color/paper_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper_background</item>
    </style>

    <style name="Theme.PaperFlight.Splash" parent="Theme.PaperFlight">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
